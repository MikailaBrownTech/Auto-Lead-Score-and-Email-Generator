{
  "name": "clearpath-lead-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "app": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @clearpath/server",
    "dev:web": "npm run dev -w @clearpath/web",
    "smoke": "npm run smoke -w @clearpath/server",
    "db:generate": "npm run db:generate -w @clearpath/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "extract-live": "npm run extract-live -w @clearpath/server --",
    "write-sequence": "npm run write-sequence -w @clearpath/server --",
    "build:web": "npm run build -w @clearpath/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
