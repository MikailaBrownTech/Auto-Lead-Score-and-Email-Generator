# Copy to .env and fill in. .env is git-ignored; never commit it.
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Two-model design: small model reads raw pages, stronger model sees only the dossier.
# Every model used must have an entry in config/prices.json or startup fails.
MODEL_EXTRACT=claude-haiku-4-5-20251001
MODEL_WRITE=claude-sonnet-5

# Hard monthly cap (USD, calendar month in UTC). Calls stop when it would be exceeded.
MONTHLY_SPEND_CAP_USD=10

# Token caps (tokens of cleaned text)
MAX_TOKENS_PER_PAGE=6000
MAX_INPUT_TOKENS_PER_LEAD=30000

# Total tokens (input + cache + output, all calls) one lead may use before it is marked budget_exceeded
LEAD_TOKEN_BUDGET=60000

# Background job concurrency
QUEUE_CONCURRENCY=2

# Local API server (always bound to 127.0.0.1)
PORT=8787
# Browser origins allowed to call the API (the Vite dev server)
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crawler identity: sent as "ClearPathLeadConsole/0.1 (+CONTACT_URL)" on every request. Required.
CONTACT_URL=https://www.clearpathsecure.com/contact

# Fetching limits
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2000000

# Fetched pages and robots.txt answers are reused for this many days
PAGE_CACHE_DAYS=7

# Paths relative to the repo root
DB_PATH=data/clearpath.db
PRICES_PATH=config/prices.json
